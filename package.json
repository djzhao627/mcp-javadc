{
  "name": "@nibfe/mcp-javadc",
  "version": "0.1.1",
  "description": "Model Context Protocol (MCP) server for Java decompilation",
  "main": "index.js",
  "type": "module",
  "bin": {
    "mcpjavadc": "index.js"
  },
  "files": [
    "index.js",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "test": "node test/mcp-tools.test.js",
    "test:setup": "node test/create-test-fixtures.js",
    "lint": "eslint index.js src/**/*.js",
    "lint:fix": "eslint --fix index.js src/**/*.js",
    "format": "prettier --write index.js src/**/*.js",
    "prepublishOnly": "npm run lint",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "java",
    "decompiler",
    "modelcontextprotocol",
    "bytecode"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.4",
    "@run-slicer/cfr": "^0.1.3-0.152",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "index.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
